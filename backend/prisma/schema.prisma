// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plant {
  id            Int             @id @default(autoincrement())
  name          String          // např. "Monstera v obýváku"
  species       String?         // např. "Monstera deliciosa"
  location      String?         // např. "Parapet na jih"
  imageUrl      String?         // Fotka rostliny (Base64 nebo URL)
  waterInterval Int             // Doporučený interval zalévání ve dnech
  lastWatered   DateTime        @default(now())
  minMoisture   Float?          @default(20.0) // Hranice vlhkosti pro alert v %
  sensorId      String?         @unique // Identifikátor čipu ESP32
  notes         String?
  createdAt     DateTime        @default(now())

  readings      SensorReading[]
  aiReports     AiReport[]
}

model SensorReading {
  id          Int      @id @default(autoincrement())
  moisture    Float    // Vlhkost půdy v %
  temperature Float?   // Teplota vzduchu ve °C
  humidity    Float?   // Vlhkost vzduchu v %
  lightLux    Float?   // Osvětlení v luxech
  createdAt   DateTime @default(now())

  plantId     Int
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

model AiReport {
  id              Int      @id @default(autoincrement())
  healthStatus    String   // "Zdravá" | "Potřebuje péči" | "Kritický stav"
  diagnosedIssue  String?  // Nalezený problém
  treatmentAdvice String?  // Doporučený postup nápravy
  createdAt       DateTime @default(now())

  plantId         Int
  plant           Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
}